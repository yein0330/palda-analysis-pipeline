PALDA_ENCODER_DIR=/models/palda-encoder
PALDA_TAXONOMY_PATH=/models/palda-encoder/taxonomy.json
PALDA_ENCODER_VERSION=encoder-v1.0.0
PALDA_ENCODER_DEVICE=cuda:0
PALDA_ENCODER_BATCH_SIZE=64
PALDA_ENCODER_MAX_LENGTH=256

PALDA_DECODER_DIR=/models/palda-decoder
PALDA_DECODER_VERSION=decoder-v1.0.0
PALDA_DECODER_DEVICE_MAP=auto
PALDA_DECODER_4BIT=1
PALDA_DECODER_BATCH_SIZE=10
# Experimental: Qwen re-reads each source item and corrects encoder labels.
PALDA_DECODER_VERIFY=0
PALDA_REVIEW_GROUP_LIMIT=3
PALDA_QNA_GROUP_LIMIT=4

PALDA_TAXONOMY_VERSION=theme-v1.0.0
PALDA_API_HOST=0.0.0.0
PALDA_API_PORT=8080
PALDA_MODEL_SUBPROCESS=1
PALDA_REDIS_URL=redis://redis:6379/0
PALDA_JOB_TTL_SECONDS=86400

# Deployment materialization: revisions must be immutable 40-character commits.
PALDA_MODEL_ROOT=/models
HF_HOME=/models/hf-cache
PALDA_ENCODER_REPO=highpixel-kr/palda-review-qna-encoder-v1
PALDA_ENCODER_REVISION=REPLACE_WITH_40_CHARACTER_HF_COMMIT
PALDA_DECODER_REPO=highpixel-kr/palda-qwen-report-lora-v1
PALDA_DECODER_REVISION=REPLACE_WITH_40_CHARACTER_HF_COMMIT
PALDA_DECODER_BASE_REPO=Qwen/Qwen2.5-7B-Instruct
PALDA_DECODER_BASE_REVISION=a09a35458c702b33eeacc393d103063234e8bc28
