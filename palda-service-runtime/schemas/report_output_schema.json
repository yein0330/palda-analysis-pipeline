{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "report-output-v1",
  "type": "object",
  "required": ["analysisId", "sample", "reviewAnalysis", "qnaAnalysis", "sellingPoints", "versions"],
  "properties": {
    "analysisId": {"type": "string", "minLength": 1},
    "sample": {
      "type": "object", "required": ["review", "qna"],
      "properties": {"review": {"$ref": "#/$defs/sample"}, "qna": {"$ref": "#/$defs/sample"}},
      "additionalProperties": false
    },
    "reviewAnalysis": {
      "type": "object", "required": ["positiveThemes", "negativeThemes"],
      "properties": {
        "positiveThemes": {"type": "array", "items": {"$ref": "#/$defs/reviewTheme"}},
        "negativeThemes": {"type": "array", "items": {"$ref": "#/$defs/reviewTheme"}}
      }, "additionalProperties": false
    },
    "qnaAnalysis": {
      "type": "object", "required": ["themes"],
      "properties": {"themes": {"type": "array", "items": {"$ref": "#/$defs/qnaTheme"}}},
      "additionalProperties": false
    },
    "sellingPoints": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/sellingPoint"}},
    "versions": {
      "type": "object", "required": ["encoderModel", "decoderModel", "taxonomy", "calculation"],
      "additionalProperties": {"type": "string"}
    }
  },
  "$defs": {
    "sample": {
      "type": "object", "required": ["collectionOrder", "sampleSize", "usableSize", "maxItems"],
      "properties": {
        "collectionOrder": {"const": "newest"},
        "sampleSize": {"type": "integer", "minimum": 0, "maximum": 5000},
        "usableSize": {"type": "integer", "minimum": 0, "maximum": 5000},
        "maxItems": {"type": "integer", "minimum": 1, "maximum": 5000}
      }, "additionalProperties": false
    },
    "reviewTheme": {
      "type": "object",
      "required": ["themeId", "theme", "mentionCount", "sentiment", "quote", "summary", "evidenceIds"],
      "properties": {
        "themeId": {"type": "string"}, "displayTheme": {"type": "string"}, "theme": {"type": "string"},
        "mentionCount": {"type": "integer", "minimum": 1},
        "sentiment": {"enum": ["positive", "negative"]},
        "quoteEvidenceId": {"type": ["string", "null"]}, "quote": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "evidenceIds": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "fallbackUsed": {"type": "boolean"}
      }, "additionalProperties": false
    },
    "qnaTheme": {
      "type": "object",
      "required": ["themeId", "theme", "primaryCount", "ratio", "question", "summary", "evidenceIds"],
      "properties": {
        "themeId": {"type": "string"}, "displayTheme": {"type": "string"}, "theme": {"type": "string"},
        "primaryCount": {"type": "integer", "minimum": 1},
        "ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "questionEvidenceId": {"type": ["string", "null"]}, "question": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "evidenceIds": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "fallbackUsed": {"type": "boolean"}
      }, "additionalProperties": false
    },
    "sellingPoint": {
      "type": "object", "required": ["type", "text", "reviewThemes", "qnaThemes", "evidenceIds", "confidence"],
      "properties": {
        "type": {"enum": ["core", "hidden", "barrier", "pain"]},
        "text": {"type": "string", "minLength": 1},
        "reviewThemes": {"type": "array", "items": {"type": "string"}},
        "qnaThemes": {"type": "array", "items": {"type": "string"}},
        "evidenceIds": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "confidence": {"type": "string"}
      }, "additionalProperties": false
    }
  },
  "additionalProperties": false
}
